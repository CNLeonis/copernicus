# Local development only. Copy to .env to override the defaults used by compose.yaml.
POSTGRES_DB=copernicus
POSTGRES_USER=copernicus
POSTGRES_PASSWORD=change-me-locally

# Used by the backend and pipeline when run outside Docker (see README).
DATABASE_URL=postgresql+psycopg://copernicus:change-me-locally@localhost:5432/copernicus
TEST_DATABASE_URL=postgresql+psycopg://copernicus:change-me-locally@localhost:5432/copernicus_test
